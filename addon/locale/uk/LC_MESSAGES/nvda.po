#. Translators: Menu item to guess item order by matching the sibling role.
#: addon\globalPlugins\itemOrderAnnouncer\filterMenu.py:44
msgid "By role"
msgstr "За роллю"

#. pyright: ignore[reportUnknownMemberType]
#. Translators: Menu item to guess item order counting all siblings, regardless of role.
#: addon\globalPlugins\itemOrderAnnouncer\filterMenu.py:46
msgid "All siblings"
msgstr "Усі сусідні об'єкти"

#. Translators: Description of a script that reports the current item's order and the total
#. number of items in a list or tree view, falling back to an estimate when exact information
#. is unavailable.
#: addon\globalPlugins\itemOrderAnnouncer\__init__.py:60
msgid "Reports the current item's order and the total number of items"
msgstr "Повідомляє порядок поточного елемента та загальну кількість елементів"

#. Translators: Reported when there is no focused object.
#: addon\globalPlugins\itemOrderAnnouncer\__init__.py:69
#: addon\globalPlugins\itemOrderAnnouncer\__init__.py:108
msgid "No focus"
msgstr "Немає фокусу"

#. Translators: Reported when pressing the item order gesture, including the nesting
#. level (e.g. in a tree view).
#: addon\globalPlugins\itemOrderAnnouncer\__init__.py:78
#, python-brace-format
msgid "{index} of {total}, level {level}"
msgstr "{index} з {total}, рівень {level}"

#. Translators: Reported when pressing the item order gesture.
#: addon\globalPlugins\itemOrderAnnouncer\__init__.py:85
#, python-brace-format
msgid "{index} of {total}"
msgstr "{index} з {total}"

#. Translators: Reported when order information could not be determined, even by estimation.
#. Translators: Reported when guessed order information could not be determined.
#: addon\globalPlugins\itemOrderAnnouncer\__init__.py:92
#: addon\globalPlugins\itemOrderAnnouncer\__init__.py:117
msgid "Order could not be guessed"
msgstr "Не вдалося визначити порядок"

#. Translators: Reported when pressing the item order gesture and falling back to an estimate.
#. Translators: Reported when pressing the guessed item order gesture.
#: addon\globalPlugins\itemOrderAnnouncer\__init__.py:97
#: addon\globalPlugins\itemOrderAnnouncer\__init__.py:120
#, python-brace-format
msgid "Approximately {index} of {total}"
msgstr "Приблизно {index} з {total}"

#. Translators: Description of a script that guesses the current item's order when exact info is unavailable.
#: addon\globalPlugins\itemOrderAnnouncer\__init__.py:101
msgid ""
"Guesses the current item's order and total count based on sibling objects "
"(thorough)"
msgstr ""
"Приблизно визначає порядок поточного елемента та загальну кількість на "
"основі сусідніх об'єктів (розширений режим)"

#. Translators: Reported when the focused object has no parent to estimate order from.
#: addon\globalPlugins\itemOrderAnnouncer\__init__.py:132
msgid "No parent object"
msgstr "Немає батьківського об'єкта"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:21
msgid "Item Order Announcer"
msgstr "Оголошення порядку елемента"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:24
msgid ""
"Quickly announces the order, total count, and nesting level of the currently "
"focused object."
msgstr ""
"Швидко оголошує порядок, загальну кількість та рівень вкладеності поточного "
"елемента у фокусі."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:29
msgid ""
"- Changed default shortcut for guessing item order to NVDA+Control+I to "
"avoid collision with NVDA built-in gestures."
msgstr ""
"- Змінено стандартну комбінацію клавіш для приблизного визначення порядку на "
"`NVDA+Control+I`, щоб уникнути конфлікту зі вбудованими жестами NVDA."

#~ msgid ""
#~ "- Added interactive filter selection popup menu (\"By role\" or \"All "
#~ "siblings\") when guessing item order via `NVDA+Shift+I`.\n"
#~ "- Added optimized fast O(1) order calculation for classic MSAA controls "
#~ "(e.g., wxWidgets, Poedit) directly via `NVDA+I`.\n"
#~ "- Automatically cancel ongoing background calculations when triggering a "
#~ "new order calculation command.\n"
#~ "- Suppressed redundant focus announcements only when selecting a filter "
#~ "menu item (ensuring focus is announced when cancelling the menu via "
#~ "Escape).\n"
#~ "- Updated Ukrainian localization and documentation."
#~ msgstr ""
#~ "- Додано інтерактивне випливаюче меню вибору фільтра («За роллю» або «Усі "
#~ "сусідні об'єкти») при визначенні порядку через `NVDA+Shift+I`.\n"
#~ "- Додано оптимізоване швидке O(1) визначення порядку для класичних MSAA-"
#~ "елементів (наприклад, wxWidgets, Poedit) напряму через `NVDA+I`.\n"
#~ "- Автоматичне скасування поточних фонових розрахунків при виклику нової "
#~ "команди визначення порядку.\n"
#~ "- Приглушення зайвих оголошень фокусу лише при виборі пункту з меню "
#~ "фільтра (при закритті меню клавішею Escape фокус оголошується як "
#~ "звичайно).\n"
#~ "- Оновлено українську локалізацію та документацію."

#~ msgid "Order not available"
#~ msgstr "Порядок недоступний"

#~ msgid ""
#~ "- Removed the word \"Item\" (\"Елемент\") from announcement messages for "
#~ "a more concise output (e.g., \"3 of 10\" instead of \"Item 3 of 10\").\n"
#~ "- Updated minimum NVDA version to 2024.1 due to Python 3.10+ syntax "
#~ "requirements (older NVDA versions use Python 3.7, while NVDA 2024.1 "
#~ "updated to Python 3.11).\n"
#~ "- Made fallback item order guessing asynchronous by running calculation "
#~ "in a background thread with periodic audio progress feedback (sound "
#~ "signal) to avoid freezing NVDA during long container traversals.\n"
#~ "- Delayed progress audio feedback to prevent unnecessary beeps on fast "
#~ "lists.\n"
#~ "- Automatically cancel background item order calculation when focus moves "
#~ "to another object.\n"
#~ "- Updated Ukrainian localization and documentation."
#~ msgstr ""
#~ "- Прибрано слово «Елемент» із повідомлень оголошення для лаконічнішого "
#~ "виводу (наприклад, «3 з 10» замість «Елемент 3 з 10»).\n"
#~ "- Оновлено мінімальну версію NVDA до 2024.1 через вимоги синтаксису "
#~ "Python 3.10+ (старіші версії NVDA використовують Python 3.7, тоді як NVDA "
#~ "2024.1 оновлено до Python 3.11).\n"
#~ "- Переведено резервне приблизне визначення порядку у фоновий потік із "
#~ "періодичним звуковим індикатором прогресу (звуковий сигнал), щоб уникнути "
#~ "зависання NVDA під час обходу великих контейнерів.\n"
#~ "- Додано затримку звукового індикатора прогресу, щоб запобігти зайвим "
#~ "звуковим сигналам на швидких списках.\n"
#~ "- Автоматичне скасування фонового розрахунку порядку елемента при "
#~ "переході фокуса на інший об'єкт.\n"
#~ "- Оновлено українську локалізацію та документацію."

#~ msgid "First release"
#~ msgstr "Перший випуск"
