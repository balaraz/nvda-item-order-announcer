#. Translators: Description of a script that reports the order of the current item in a list or tree view.
#: addon\globalPlugins\item_order_announcer.py:38
msgid "Reports the current item's order and the total number of items"
msgstr "Повідомляє порядок поточного елемента та загальну кількість елементів"

#. Translators: Reported when there is no focused object.
#: addon\globalPlugins\item_order_announcer.py:45
#: addon\globalPlugins\item_order_announcer.py:84
msgid "No focus"
msgstr "Немає фокусу"

#. Translators: Reported when order information is not available for the focused object.
#: addon\globalPlugins\item_order_announcer.py:51
#: addon\globalPlugins\item_order_announcer.py:60
msgid "Order not available"
msgstr "Порядок недоступний"

#. Translators: Reported when pressing the item order gesture, including the nesting level (e.g. in a tree view).
#: addon\globalPlugins\item_order_announcer.py:65
#, python-brace-format
msgid "Item {index} of {total}, level {level}"
msgstr "Елемент {index} з {total}, рівень {level}"

#. Translators: Reported when pressing the item order gesture.
#: addon\globalPlugins\item_order_announcer.py:72
#, python-brace-format
msgid "Item {index} of {total}"
msgstr "Елемент {index} з {total}"

#. Translators: Description of a script that guesses the current item's order when exact info is unavailable.
#: addon\globalPlugins\item_order_announcer.py:78
msgid ""
"Guesses the current item's order and total count based on sibling objects"
msgstr ""
"Приблизно визначає порядок поточного елемента та загальну кількість на "
"основі сусідніх об'єктів"

#. Translators: Reported when guessed order information could not be determined.
#: addon\globalPlugins\item_order_announcer.py:90
msgid "Order could not be guessed"
msgstr "Не вдалося визначити порядок"

#. Translators: Reported when pressing the guessed item order gesture.
#: addon\globalPlugins\item_order_announcer.py:95
#, python-brace-format
msgid "Approximately item {index} of {total}"
msgstr "Приблизно елемент {index} з {total}"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:21
msgid "Item Order Announcer"
msgstr "Оголошення порядку елемента"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:24
msgid ""
"Quickly announces the order, total count, and nesting level of the currently "
"focused object."
msgstr ""
"Швидко оголошує порядок, загальну кількість та рівень вкладеності поточного "
"елемента у фокусі."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:29
msgid "First release"
msgstr "Перший випуск"
